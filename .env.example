# =============================================================================
# Hukan SEO Auditor — Environment Variables
# Copy to .env and fill in real values. Never commit .env
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL) — optional if using Firebase only
DATABASE_URL=postgresql://user:password@localhost:5432/hukan_seo_auditor?schema=public

# NextAuth / Auth (legacy path; Firebase Auth is primary going forward)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret-at-least-32-chars

# Optional: Google OAuth (for login + Search Console later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment — choose one or more Kenyan-compatible providers
# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# Paystack (supports Kenya)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email (transactional)
EMAIL_FROM=noreply@hukan.example
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Object storage for PDF reports (optional in dev)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Crawler limits (safety)
CRAWLER_MAX_PAGES=100
CRAWLER_MAX_DEPTH=5
CRAWLER_TIMEOUT_MS=15000
CRAWLER_USER_AGENT=HukanSEOAuditor/1.0 (+https://hukan.example/bot)

# Admin bootstrap (first admin email)
ADMIN_EMAIL=admin@example.com

# Optional AI for explanations only (never for inventing metrics)
OPENAI_API_KEY=
XAI_API_KEY=

# Worker / cron
CRON_SECRET=
WORKER_POLL_MS=5000

# =============================================================================
# Firebase (Auth + Firestore) — primary backend going forward
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Emulators (optional)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
